# Vercel Dashboard → Project → Settings → Environment Variables
# Apply to: Production, Preview, and Development

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_URL=https://seldom-nine.vercel.app
SUPABASE_URL=
SUPABASE_ANON_KEY=
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=
OLLAMA_API_KEY=
ALLOWED_ORIGINS=https://seldom-nine.vercel.app

# Notes:
# - OLLAMA_BASE_URL must be reachable FROM Vercel's servers (not localhost).
#   Use a VPS, Cloudflare Tunnel, Tailscale Funnel, or similar for production.
# - For local dev only, use .env.local with OLLAMA_BASE_URL=http://localhost:11434
# - Pull env locally: npx vercel env pull .env.local
