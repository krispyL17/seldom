# Copy to .env.local for local dev (vercel dev)
# Copy the same keys to Vercel Dashboard → Settings → Environment Variables for production

# ── Supabase (required) ──────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Public URL of your deployed app (fixes confirmation emails pointing at localhost)
# Local: http://localhost:3000  |  Production: https://your-app.vercel.app
VITE_APP_URL=http://localhost:3000

# ── Ollama (required for AI) ─────────────────────────────────
# Local dev: Ollama on this machine
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Optional: embedding model for semantic memory (defaults to OLLAMA_MODEL)
# OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional: Bearer token if Ollama is behind a secured reverse proxy / tunnel
# OLLAMA_API_KEY=

# ── Production only ──────────────────────────────────────────
# Vercel cannot reach localhost — point to a remote Ollama URL (VPS, tunnel, etc.)
# OLLAMA_BASE_URL=https://your-ollama-tunnel.example.com

# Comma-separated origins for API CORS (optional — Vercel preview URLs auto-allowed)
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com

# ── Optional ─────────────────────────────────────────────────
# RESEND_API_KEY=
# RESEND_FROM=Seldom <reminders@yourdomain.com>
