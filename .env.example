# ─── Supabase (required for auth + database) ───────────────────────────────
# 1. Create a project at https://supabase.com/dashboard
# 2. Go to Project Settings → API
# 3. Copy the values below into a new file called .env.local
#
# IMPORTANT: Never commit .env.local — it is listed in .gitignore

# Project URL (Settings → API → Project URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Anonymous public key (Settings → API → anon public)
# Safe to expose in the browser — Row Level Security protects your data
VITE_SUPABASE_ANON_KEY=your-anon-key-here
